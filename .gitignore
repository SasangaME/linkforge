# Terraform state — never commit. Contains resource IDs and often secrets in plaintext.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Provider binaries and module cache — downloaded, not source.
.terraform/
.terragrunt-cache/

# Real variable values. The example file is committed as a template.
*.tfvars
*.tfvars.json
!example.tfvars

# Crash dumps
crash.log
crash.*.log

# macOS
.DS_Store