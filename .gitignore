# Terraform state — never commit. Contains resource IDs and often secrets in plaintext.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files — binary, derived, and contain full state values in plaintext.
*.tfplan
tfplan

# Provider binaries and module cache — downloaded, not source.
.terraform/
.terragrunt-cache/

# Real variable values. Never committed. The required inputs and their
# descriptions live in account/variables.tf.
*.tfvars
*.tfvars.json

# Crash dumps
crash.log
crash.*.log

# macOS
.DS_Store

# Local working notes — personal scratch, not part of the deliverable.
*.local.md
# Lock files belong to root modules. A child module under modules/ gets one
# only as a side effect of running init there by hand.
modules/*/.terraform.lock.hcl
