#!/bin/bash
# Runs once, at first boot. Output lands in /var/log/cloud-init-output.log,
# which is the first place to look when the host registers and /health does not
# answer. -x is on for exactly that reason.
set -euxo pipefail


cat > /opt/health.py <<'PY'
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = ${health_port}


class Handler(BaseHTTPRequestHandler):
    # BaseHTTPRequestHandler speaks HTTP/1.0 unless told otherwise, so an ALB's
    # HTTP/1.1 health check gets a 1.0 answer and opens a fresh TCP connection
    # every thirty seconds. Safe only because every response below sets
    # Content-Length — under 1.1 a response without one hangs the client
    # rather than erroring, so that header is now load-bearing.
    protocol_version = "HTTP/1.1"

    # The other half of the same change. Under 1.0 every connection closed
    # after one response; under 1.1 keep-alive holds a thread until the client
    # goes away, and a half-open connection holds it indefinitely.
    timeout = 5

    def do_GET(self):
        ok = self.path == "/health"
        body = b"ok\n" if ok else b"not found\n"
        self.send_response(200 if ok else 404)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    # The default handler logs every request to stderr, which in a target group
    # health check is one line every thirty seconds, forever.
    def log_message(self, *args):
        pass

ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
PY

cat > /etc/systemd/system/health.service <<'UNIT'
[Unit]
Description=LinkForge v1-network health responder
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/health.py
Restart=always
RestartSec=2
# A transient unprivileged user, created for this unit and discarded with it.
# The port is above 1024, so nothing here needs root.
DynamicUser=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now health.service